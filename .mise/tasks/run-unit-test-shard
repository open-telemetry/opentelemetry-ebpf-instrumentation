#!/usr/bin/env bash
#MISE description="Run one unit-test matrix shard"
set -euo pipefail
assets="$("$MISE_MONOREPO_ROOT/.mise/scripts/go-tool" setup-envtest use "$ENVTEST_K8S_VERSION" -p path)"
KUBEBUILDER_ASSETS="$assets" "$MISE_MONOREPO_ROOT/.mise/scripts/go-tool" gotestsum --jsonfile="${TEST_OUTPUT:-./testoutput}/unit-test-shard-${SHARD_ID:?SHARD_ID must be set}.log" -- -short -race -coverpkg=./... -coverprofile "${TEST_OUTPUT:-./testoutput}/cover.all.txt" ${UNIT_TEST_PACKAGES:-}
