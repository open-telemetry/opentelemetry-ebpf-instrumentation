#!/usr/bin/env bash
#MISE description="Run Go unit tests with race detection and coverage"
set -euo pipefail
mkdir -p "${TEST_OUTPUT:-./testoutput}"
export KUBEBUILDER_ASSETS="$(go tool -modfile=internal/tools/go.mod setup-envtest use "${ENVTEST_K8S_VERSION:-1.30.0}" -p path)"
go test -short -race ./... -coverpkg=./... -coverprofile "${TEST_OUTPUT:-./testoutput}/cover.all.txt"
