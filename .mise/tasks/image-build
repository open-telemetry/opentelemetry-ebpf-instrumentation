#!/usr/bin/env bash
#MISE description="Build the OCI application image"
#MISE depends=["generator-image-build"]
set -euo pipefail
: "${IMG_ORG:?IMG_ORG must be set (Docker repository user name)}"
version="${RELEASE_VERSION:-$(git describe --all | cut -d/ -f2-)}"
revision="${RELEASE_REVISION:-$(git rev-parse --short HEAD)}"
oci_bin="$OCI_BIN"
generator_layout="${GENERATOR_OCI_LAYOUT:-$MISE_CONFIG_ROOT/testoutput/mise-generator-layout}"
generator_context="oci-layout://$generator_layout:local"
"$oci_bin" buildx build --load -t "${IMG:-${IMG_REGISTRY:-docker.io}/${IMG_ORG}/${IMG_NAME:-ebpf-instrument}:${VERSION:-dev}}" --build-context "$GENERATOR_CONTEXT=$generator_context" --build-arg "GENERATOR_BASE=$GENERATOR_CONTEXT" --build-arg "RELEASE_VERSION=$version" --build-arg "RELEASE_REVISION=$revision" .
