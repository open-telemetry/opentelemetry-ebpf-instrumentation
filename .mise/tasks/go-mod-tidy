#!/usr/bin/env bash
#MISE description="Tidy all Go modules in parallel"
set -euo pipefail

max_jobs="${GO_MOD_TIDY_JOBS:-4}"
if [[ ! "$max_jobs" =~ ^([1-9]|1[0-6])$ ]]; then
  echo "GO_MOD_TIDY_JOBS must be an integer from 1 to 16 (got '$max_jobs')" >&2
  exit 2
fi

modules=()
while IFS= read -r file; do
  modules+=("$file")
done < <(find . -type f -name go.mod ! -path './NOTICES/*' | sort)

if ((${#modules[@]} == 0)); then
  exit 0
fi

# xargs processes queued modules after failures, then returns nonzero.
printf '%s\0' "${modules[@]}" |
  xargs -0 -n 1 -P "$max_jobs" bash -c '
    set -euo pipefail
    file="$1"
    dir="$(dirname "$file")"
    echo "### Running go mod tidy in $dir"

    if [[ "$dir" == *testserver_1.17 ]]; then
      (cd "$dir" && go mod tidy -go=1.17 -compat=1.17)
    else
      (cd "$dir" && go mod tidy)
    fi
  ' _
