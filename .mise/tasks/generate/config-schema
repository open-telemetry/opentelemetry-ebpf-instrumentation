#!/usr/bin/env bash
#MISE description="Generate configuration schema and docs"
#MISE alias="generate-config-schema"
set -euo pipefail
schema="$CONFIG_SCHEMA_FILE"
docs="$CONFIG_DOCS_FILE"
mkdir -p "$(dirname "$schema")"
go run ./cmd/obi-schema -output "$schema"
go run ./cmd/config-docs -schema "$schema" -output "$docs"
