#!/usr/bin/env bash
set -euo pipefail
notices="${NOTICES_DIR:-./NOTICES}"
find "$notices" -mindepth 1 -maxdepth 1 ! -name bpf ! -name java ! -name amd64 ! -name arm64 -exec rm -rf {} +
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT
env -u GOOS -u GOARCH go build -C "$MISE_MONOREPO_ROOT/internal/tools" -o "$tmpdir/go-licenses" github.com/google/go-licenses/v2
for arch in amd64 arm64; do
  rm -rf "$notices/$arch"
  GOOS=linux GOARCH="$arch" "$tmpdir/go-licenses" save ./... --save_path="/tmp/notices-$arch" --force
  mv "/tmp/notices-$arch" "$notices/$arch"
done
