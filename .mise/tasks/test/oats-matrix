#MISE description="Check OATS matrix entries resolve to registered test tasks"
set -euo pipefail

cd "$MISE_MONOREPO_ROOT"

python3 - <<'PYTHON'
import json
import pathlib
import subprocess

matrix = json.loads(subprocess.run(
    ["mise", "run", "//oats:integration-test-matrix-json"],
    check=True, text=True, capture_output=True,
).stdout)
tasks = json.loads(subprocess.run(
    ["mise", "tasks", "--json", "--all"],
    check=True, text=True, capture_output=True,
).stdout)
task_names = {task["name"] for task in tasks}
for entry in matrix["include"]:
    suite = entry["suite"]
    task_name = f"//internal/test/oats:test:{suite}"
    if task_name not in task_names:
        raise SystemExit(f"OATS suite {suite!r} has no registered task {task_name}")
    for case in entry["cases"]:
        path = pathlib.Path("internal/test/oats") / suite / case
        if not path.is_file():
            raise SystemExit(f"OATS matrix case does not exist: {path}")
PYTHON
