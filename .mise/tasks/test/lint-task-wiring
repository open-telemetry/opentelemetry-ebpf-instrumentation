#MISE description="Check Go lint task aliases and wiring"
set -euo pipefail

assert_task_aliases() {
	local canonical="$1"
	shift
	local info
	info="$(mise tasks info "//:$canonical")"
	grep -Fq "Task: //:$canonical" <<<"$info"
	for alias in "$@"; do
		info="$(mise tasks info "//:$alias")"
		grep -Fq "Task: //:$canonical" <<<"$info"
	done
}

assert_task_aliases lint lint-run
assert_task_aliases lint:fix lint-fix
assert_task_aliases lint:clean-cache lint-clean-cache
assert_task_aliases lint:dependency-policy lint-dependency-policy
assert_task_aliases lint:collectt lint-collectt
assert_task_aliases lint:collectt:fix lint-collectt-fix
assert_task_aliases lint:preempt-guard lint-preempt-guard
assert_task_aliases vanity-import:check vanity-import-check
assert_task_aliases vanity-import:fix-check vanity-import-fix-check
assert_task_aliases vanity-import:fix vanity-import-fix

lint_plan="$(mise run --dry-run //:lint 2>&1)"
grep -Fq 'golangci-lint run ./... --timeout=6m' <<<"$lint_plan"
grep -Fq 'cd collector && golangci-lint run ./... --timeout=6m' <<<"$lint_plan"

lint_fix_plan="$(mise run --dry-run //:lint:fix 2>&1)"
grep -Fq 'golangci-lint run ./... --timeout=6m --fix' <<<"$lint_fix_plan"
grep -Fq 'cd collector && golangci-lint run ./... --timeout=6m --fix' <<<"$lint_fix_plan"

echo 'Go lint task aliases and wiring are consistent.'
