#!/usr/bin/env bash
set -euo pipefail
release_dir="${RELEASE_DIR:-./dist}"; version="${RELEASE_VERSION:-$(git describe --all | cut -d/ -f2-)}"
mkdir -p "$release_dir"; cd "$release_dir"
files="$(find . -maxdepth 1 \( -name "obi-${version}-*.tar.gz" -o -name "obi-${version}-*.cyclonedx.json" -o -name "obi-java-agent-${version}.cyclonedx.json" \) | sed 's|^./||' | sort)"
[[ -n "$files" ]] || { echo "ERROR: No release artifacts found for obi-${version} in $release_dir"; exit 1; }
if command -v sha256sum >/dev/null 2>&1; then printf '%s\n' "$files" | xargs sha256sum > SHA256SUMS
elif command -v shasum >/dev/null 2>&1; then printf '%s\n' "$files" | xargs shasum -a 256 > SHA256SUMS
else echo 'ERROR: Neither sha256sum nor shasum found.'; exit 1; fi
