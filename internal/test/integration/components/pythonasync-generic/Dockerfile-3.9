FROM python:3.14@sha256:e06cc1111ed84189e91866447f562b89faadbfbbb9937cd67e6bf4172cdb45df
EXPOSE 8392

WORKDIR /app

# Reuses the pythonasync-uvloop lock file; this app needs a subset of it
COPY internal/test/integration/components/pythonasync-uvloop/requirements-3.9.txt .
RUN pip install --require-hashes -r requirements-3.9.txt

COPY internal/test/integration/components/pythonasync-common/cancelled_to_thread.py .
COPY internal/test/integration/components/pythonasync-generic .

CMD ["python", "async_server_test.py"]
