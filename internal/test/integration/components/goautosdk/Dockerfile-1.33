# Build the Auto SDK activation fixture.
FROM golang:1.27.3@sha256:2920bb124f1a2e12a1d39f0cab756ae0068441ee1da7655dec7f5e374944095b AS builder

ARG TARGETARCH

ENV GOARCH=$TARGETARCH

WORKDIR /src

COPY internal/test/integration/components/goautosdk/main.go internal/test/integration/components/goautosdk/external.go ./
COPY internal/test/integration/components/goautosdk/v1.33/go.mod .
COPY internal/test/integration/components/goautosdk/v1.33/go.sum .

RUN go build -o goautosdk .

FROM debian:bookworm-slim@sha256:74d56e3931e0d5a1dd51f8c8a2466d21de84a271cd3b5a733b803aa91abf4421

WORKDIR /
COPY --from=builder /src/goautosdk .
USER 0:0

CMD ["/goautosdk"]
