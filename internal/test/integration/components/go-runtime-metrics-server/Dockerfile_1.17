# Build the compatibility test binary with the oldest Go version covered here.
FROM golang:1.17.13@sha256:87262e4a4c7db56158a80a18fefdc4fee5accc41b59cde821e691d05541bbb18 AS builder

ARG TARGETARCH
ARG RUNTIME_METRICS_TESTSERVER_LDFLAGS

ENV GOARCH=$TARGETARCH

WORKDIR /src

COPY internal/test/integration/components/go-runtime-metrics-server/main.go .

RUN --mount=type=cache,target=/root/.cache/go-build --mount=type=cache,target=/go/pkg/mod GO111MODULE=off go build -ldflags="${RUNTIME_METRICS_TESTSERVER_LDFLAGS}" -o testserver main.go

FROM debian:bookworm-slim@sha256:74d56e3931e0d5a1dd51f8c8a2466d21de84a271cd3b5a733b803aa91abf4421

WORKDIR /
COPY --from=builder /src/testserver .
USER 0:0

CMD [ "/testserver" ]
