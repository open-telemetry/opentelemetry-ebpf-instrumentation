FROM ruby:3.4.8-slim@sha256:ff7780d9fc05a54690c722ee0621bae2aa818331be88ebbeb0f5e7bd7cdb7f37

RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends build-essential libpq-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV BUNDLE_PATH=/usr/local/bundle

COPY internal/test/integration/components/rubytestserver/tapasapi .
# Keep the shared gem versions, updating only the Ruby version in the image's lockfile.
RUN gem install bundler -v 4.0.16 && \
    bundle _4.0.16_ update --ruby && bundle _4.0.16_ install

EXPOSE 3040

CMD ["bundle", "exec", "puma", "-b", "tcp://0.0.0.0:3040", "config.ru"]
